    "A cleanup run is already going.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En oprydningskørsel er allerede i gang."
          }
        }
      }
    },
    "A delay profile is holding grabs on purpose — usenet {usenet}m, torrent {torrent}m.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En forsinkelsesprofil holder bevidst hentninger tilbage — usenet {usenet} min, torrent {torrent} min."
          }
        }
      }
    },
    "A free developer signature lasts seven days. In its last two days, reinstalling from your Mac renews it for another seven.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En gratis udviklersignatur holder i syv dage. I de sidste to dage fornyer en geninstallation fra din Mac den med syv dage mere."
          }
        }
      }
    },
    "A release was grabbed and rejected, so it will not be tried again: {release} from {indexer}.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En udgivelse blev hentet og afvist, så den prøves ikke igen: {release} fra {indexer}."
          }
        }
      }
    },
    "A server keeps at most %lld rules.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En server har højst %lld regler."
          }
        }
      }
    },
    "A test run shows what a run would do now and changes nothing.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En prøvekørsel viser, hvad en kørsel ville gøre nu, og ændrer intet."
          }
        }
      }
    },
    "A title must meet every condition that is ticked.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En titel skal opfylde alle de betingelser, der er sat flueben ved."
