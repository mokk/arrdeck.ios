      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema"
          }
        }
      }
    },
    "These choices are kept on this device only.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgene gemmes kun på denne enhed."
          }
        }
      }
    },
    "These choices are kept on this device only. Drag the tabs to reorder them.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgene gemmes kun på denne enhed. Træk fanerne for at ændre rækkefølgen."
          }
        }
      }
    },
    "These choices follow you to your other devices on this server, except the language, which is set per device. Drag the tabs to reorder them.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse valg følger dig til dine andre enheder på denne server, undtagen sproget, som vælges på hver enhed. Træk fanerne for at ændre rækkefølgen."
          }
        }
      }
    },
    "This address asks for sign-in, so it is not a home address the app can use": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne adresse kræver login, så appen kan ikke bruge den som hjemmeadresse"
          }
        }
      }
    },
    "This server can't import files by hand.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne server kan ikke importere filer manuelt."
          }
        }
      }
    },
    "Those seasons are unmonitored so they are not fetched again; the shows stay.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De sæsoner overvåges ikke længere, så de ikke hentes igen; serierne bliver."
