          "stringUnit": {
            "state": "translated",
            "value": "Tester…"
          }
        }
      }
    },
    "The album you choose goes to every file that has none yet, and Lidarr works out which track each one is.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det album, du vælger, gælder for alle filer, der ikke har et endnu, og Lidarr finder selv ud af, hvilket nummer hver fil er."
          }
        }
      }
    },
    "The arr found nothing to import here.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arr'en fandt intet at importere her."
          }
        }
      }
    },
    "The calendar needs Radarr, Sonarr, Readarr or Lidarr.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderen kræver Radarr, Sonarr, Readarr eller Lidarr."
          }
        }
      }
    },
