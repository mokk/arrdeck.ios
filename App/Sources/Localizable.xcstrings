    "Spoiler protection": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoilerbeskyttelse"
          }
        }
      }
    },
    "Spoiler protection hides the titles and summaries of episodes Plex has not seen you watch; tap one to show it. Deleting a title always asks whether to keep its files.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoilerbeskyttelse skjuler titler og resuméer på afsnit, Plex ikke har set dig se; tryk for at vise dem. Sletning af en titel spørger altid, om filerne skal beholdes."
          }
        }
      }
    },
